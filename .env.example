# Telegram: token from @BotFather
BOT_TOKEN=123456:ABC...
# Any long random string (letters/digits), used to verify requests really come from Telegram
WEBHOOK_SECRET=change_me_long_random_string
# Any long random string, used once to register the webhook (/api/setup-webhook?key=...)
SETUP_KEY=change_me_another_random_string
# Your own Telegram numeric chat id: you get a message for every paid order (send /id to the bot)
ADMIN_CHAT_ID=

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Bakong (server side only)
BAKONG_API_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_ACCOUNT_ID=abaakhppxxx@abaa
ACCOUNT_INFO_KHR=your_khr_account_number
ACQUIRING_BANK=ABA Bank
MERCHANT_NAME=Apple Shop
MERCHANT_CITY=Phnom Penh

# Shop
PRICE_KHR=500
MAX_QTY=100
QR_EXPIRE_MINUTES=10

# Optional: protects /api/cron-check (Vercel sends it automatically)
CRON_SECRET=
